# ──────────────────────────────────────────
# CV Builder — Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Auth
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=1440

# Agent temperatures
EXTRACTOR_TEMP=0.2
TAILOR_TEMP=0.5
EVALUATOR_TEMP=0.3
FORMATTER_TEMP=0.3

# Eval loop
MAX_EVAL_LOOPS=3
